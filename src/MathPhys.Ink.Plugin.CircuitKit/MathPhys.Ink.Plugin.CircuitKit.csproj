<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MathPhys.Ink.Plugin.CircuitKit</RootNamespace>
    <!-- dll 名与目录名一致：加载器的约定是 plugins\circuitkit\circuitkit.dll -->
    <AssemblyName>circuitkit</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与其它学科工具同款：只引用契约；渲染器由宿主扫同名 dll 自动登记 -->
    <ProjectReference Include="..\MathPhys.Ink.Plugin.Abstractions\MathPhys.Ink.Plugin.Abstractions.csproj" />
  </ItemGroup>

</Project>
