<Window x:Class="MathPhys.Ink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MathPhys.Ink.Views.Controls"
        Title="数理墨" Height="800" Width="1400"
        WindowStyle="None" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Family}"
        FontSize="{StaticResource Text.Body}"
        Background="{DynamicResource Ui.WindowBackground}">

    <!-- ================================================================
         M10 起这个文件里的**每一个颜色、字号、间距都来自设计令牌**
         （Design/*.xaml）。判断标准很简单：这里不应该再出现 #RRGGBB，
         也不应该再出现"这个数看起来是随手写的"。

         ★ 界面板的引用一律 {DynamicResource}（换肤要立刻生效）；
           画布板（Canvas.*）与图标几何（Icon.*）用 {StaticResource}（永不随主题变）。
         ================================================================ -->

    <DockPanel>

        <!-- ============ 顶部工具栏 ============
             排成**两行**而不是一个 WrapPanel（M10 S4 的重排）：
             一行装"文档与工程"，一行装"笔与工具"。
             原先一个大 WrapPanel 在字号提到 15 之后会随机换行，
             "保存"可能被挤到第二行、"撤销"跑到第三行 —— 现场找一个按钮全靠运气。

             ★ 右上角两颗常驻按钮（窗口模式 / 主题）用 Dock=Right：
               全屏时没有标题栏，一体机上又没有键盘，它们是老师唯一的退路，
               绝不能随 WrapPanel 换行被挤到看不见的地方。 -->


        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Style.StatusBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="笔 / 橡皮：触摸即书写 · 手：单指平移、双指捏合 · 滚轮随时缩放 · 右上角按钮 / F11 切换全屏"
                           Style="{StaticResource Style.TextCaption}" />

                <!-- 笔迹条数由 code-behind 更新：XAML 里禁用带 {} 的 StringFormat -->
                <TextBlock x:Name="InkCountText" Text="笔迹 0 条"
                           Style="{StaticResource Style.TextCaption}"
                           MinWidth="92" Margin="0,0,16,0" />

                <!-- 批注存档状态（已保存 / 未保存 / 警告）。颜色随状态变（由 code-behind 设），
                     一体机上离得远，靠颜色比靠读文字更快看出"刚才那一笔存住了没有"。 -->
                <TextBlock x:Name="AnnotationStatusText" Text=""
                           Style="{StaticResource Style.TextCaption}"
                           MinWidth="180" Margin="0,0,16,0" />

                <TextBlock Text="{Binding Status}" Style="{StaticResource Style.TextBody}" />
            </DockPanel>
        </Border>

        <!-- 画布 + GeoGebra 停靠区（M7.5 S3）。
             ★ 两者必须是并列的布局单元（Grid 两列），绝不能让停靠区叠在画布上：
               WebView2 是基于 HWND 的控件，永远渲染在所有 WPF 元素之上（空气空间问题），
               叠上去的区域里墨迹、图形、按钮全部既看不见也点不着。
             并列之后：
             · 停靠时画布自动缩小让出右侧（"画布缩小让位"由布局天然保证）；
             · "触摸边缘不误触"也由布局保证 —— 两个区域不相交，
               触点落在哪边就归哪边，不存在跨界泄漏。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 画布列：画布 + 顶部唤出条 + 悬浮球叠在同一格里。
                 ★ 都不进 WorldHost —— 屏幕坐标元素绝不随世界缩放/平移。 -->
            <!-- 画布列：浮动工具栏 + 悬浮球叠在画布上（M13 S4 起，原顶部 Dock 条迁入此格）。
                 ★ 都不进 WorldHost —— 屏幕坐标元素绝不随世界缩放/平移。 -->
            <Grid x:Name="CanvasOverlayGrid" Grid.Column="0">
                <!-- 无限画布 -->
                <controls:CanvasViewportHost x:Name="ViewportHost" />

                <Border x:Name="TopChrome" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Style="{StaticResource Style.ChromeBar}" Margin="12,12,0,0" MaxWidth="500">
                  <StackPanel>

                    <!-- M13 S4：把手条 —— 只有它响应拖动（FloatingDrag），按钮点击零冲突；
                         右侧「收起」是显隐的按钮入口（悬浮球菜单 / F9 同效）。
                         M16：拖动中走渲染变换（不触发布局），松手才落 Margin —— 213Hz 触摸率下不再卡。 -->
                    <DockPanel Height="30" Margin="0,0,0,4">
                        <Button x:Name="ToolbarCollapseButton" DockPanel.Dock="Right"
                                Content="收起 ▲" Click="OnToolbarCollapseClick"
                                Style="{StaticResource Style.ToolbarButton}"
                                MinWidth="72" Height="26" Margin="8,0,0,0"
                                ToolTip="收起工具栏：之后点悬浮球（或按 F9）呼回" />
                        <Border x:Name="ToolbarGrip" Background="Transparent" Cursor="SizeAll">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Ui.TextDisabled}" Margin="3,0" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Ui.TextDisabled}" Margin="3,0" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Ui.TextDisabled}" Margin="3,0" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Ui.TextDisabled}" Margin="3,0" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Ui.TextDisabled}" Margin="3,0" />
                                <TextBlock Text="拖这里挪动工具栏" VerticalAlignment="Center"
                                           Style="{StaticResource Style.TextCaption}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- ================ 状态行（M16 重排）================
                         工程标识 / 文档信息 / 题号位置 / 缩放比例都是"看的信息"，不是按钮 ——
                         独占一行放最上面，宽度不够时自然换行，不参与下方瓦片流。 -->
                    <WrapPanel Margin="0,2,0,0">
                        <!-- 工程标识（M8）：「文件名 · 内嵌/外挂 · ● 未保存」。内嵌还是外挂必须摆在明处：
                             它直接决定老师下一步动作 —— 内嵌的拷一个文件就够，外挂的必须连试卷一起拷。 -->
                        <TextBlock x:Name="ProjectText" Text="（未打开工程）"
                                   Style="{StaticResource Style.TextBody}"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Document.DisplayName}"
                                   Style="{StaticResource Style.TextStrong}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Document.PageCountText}"
                                   Style="{StaticResource Style.TextBody}"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="QuestionIndexText" Text=""
                                   Style="{StaticResource Style.TextLabel}"
                                   MinWidth="72" Margin="0,0,8,0" />
                        <TextBlock x:Name="ZoomText" Text="100%"
                                   Style="{StaticResource Style.TextStrong}"
                                   MinWidth="48" />
                    </WrapPanel>

                    <!-- ================ 瓦片区（M16 方形重排）================
                     限宽（MaxWidth=500）让按钮自然换行成方阵：图标在上、文字在下，
                     每格 76 宽 —— 以前的"横贯全屏长条"遮挡试卷，方阵只占左侧一列。
                     ★ 所有按钮的 x:Name / Click / 命令与重排前完全一致，纯排版层改动。
                     ★ 不再放竖直分隔线：换行流里分隔线位置不可控，分组靠间距与排列顺序。 -->
                    <!-- ================ 瓦片区（M20 S4：四组 + 组间横线）================
                         从「一个紧密排布的大流」改成「四个组块」：

                         · 每组 = 一个 WrapPanel，瓦片在组内自己换行；
                         · 组标题（Style.GroupHeaderChip）是**行内**窄标签 —— 它必然落在
                           该组第一行的行首，而那一行本来就填不满，等于不花高度。
                           （做成"独占一行的标题"每组要白花 50px，四组 200px，
                             一体机屏只有 720 高，那会把最下面的按钮顶出屏幕外。）
                         · 组间一条**全宽横线**（Style.GroupDivider）—— 这就是需求的"组间分隔线"。
                           它是组块之间的独立一行，位置由"哪两组之间"决定，与换行无关，
                           所以不会出现 M16 当年担心的"分隔线落到行首/行尾"。
                         · 二级工具进 Popup：工具族的变体（直尺/三角板/圆规/矢量）、
                           「导出 PNG / PDF」、「回放/计算器/纸张/模式」。
                           于是可见瓦片 22 → 16、动作类再省 4 格，**功能一个没少**。

                         ★★ 工具瓦片由 code-behind 按 Tools/ToolCatalog.cs 生成，直接塞进
                            ToolButtons / InkToolButtons / OtherToolButtons 三个面板，**不用 ItemsControl**：
                            WrapPanel 量每个子元素时给的是「整行的可用宽度」而不是「本行剩下的宽度」，
                            所以嵌套的 WrapPanel/ItemsControl 会以为自己独占一整行（宽度按 492 算），
                            于是被外层换到新的一行、把组标题孤零零丢在上一行 ——
                            实测白花 44px 高（四个组就是 176px，正好把工具栏顶出屏幕）。
                            一律做**直接子元素**，谁都不会算错。

                         ★ 所有按钮的 x:Name / Click / 命令与重排前完全一致，是纯排版层改动。 -->
                    <StackPanel x:Name="ToolbarGroups" Margin="0,8,0,0">

                        <!-- ================= 组 1 · 笔类 ================= -->
                        <WrapPanel x:Name="GroupPanelInk">
                            <Border Style="{StaticResource Style.GroupHeaderChip}">
                                <TextBlock Style="{StaticResource Style.GroupHeaderLabel}" Text="笔类" />
                            </Border>

                            <!-- 笔 / 橡皮 / 手 由 code-behind 从工具目录表生成。
                                 ★ 这里用一个**内层** WrapPanel 而不是直接挂在组面板上：
                                   原因是这三颗瓦片要排在"组标题之后、墨色之前"这个位置，
                                   而 code-behind 只会往容器里 Append。内层容器只有 3 颗瓦片
                                   （约 246 宽 < 一行的 492），量出来的宽度就是它自己的实际宽度，
                                   不会把组标题挤到上一行去。 -->
                            <WrapPanel x:Name="InkToolButtons" />

                            <!-- ==== 墨色（6 色，颜色由 code-behind 按 InkPalette 填。第 6 档「白」是深色纸底的配套）==== -->
                            <TextBlock Text="墨色" Style="{StaticResource Style.TextLabel}"
                                       VerticalAlignment="Center" Margin="{StaticResource Gap.Tile}" />

                            <Button x:Name="ColorButton0" Tag="0" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="ColorButton1" Tag="1" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="ColorButton2" Tag="2" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="ColorButton3" Tag="3" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="ColorButton4" Tag="4" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="ColorButton5" Tag="5" Click="OnColorClick"
                                    Style="{StaticResource Style.InkSwatch}" Margin="{StaticResource Gap.Tile}" />

                            <!-- ==== 笔宽（world 单位，随画布缩放一起变粗）==== -->
                            <TextBlock Text="笔宽" Style="{StaticResource Style.TextLabel}"
                                       VerticalAlignment="Center" Margin="{StaticResource Gap.Tile}" />

                            <Button x:Name="WidthButton0" Tag="0" Click="OnWidthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="WidthButton1" Tag="1" Click="OnWidthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="WidthButton2" Tag="2" Click="OnWidthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="WidthButton3" Tag="3" Click="OnWidthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />

                            <!-- ==== 压感 ==== -->
                            <CheckBox x:Name="PressureCheckBox"
                                      Click="OnPressureClick"
                                      Style="{StaticResource Style.CheckBox}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource Gap.Tile}"
                                      ToolTip="开：用力写粗、轻写细。关（默认）：笔宽恒定。
        设备若不报压力（鼠标、部分电容笔），开压感会让笔迹统一变成一半粗，
        届时程序会自动把该笔画按恒定笔宽处理。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Pressure}" />
                                    <TextBlock Text="压感" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>

                            <!-- ==== 笔锋（M11）：合成关系只在 CanvasViewportHost.SyncInkPressureSettings 一处 ==== -->
                            <CheckBox x:Name="CraftCheckBox" Content="笔锋"
                                      Click="OnCraftClick"
                                      Style="{StaticResource Style.CheckBox}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource Gap.Tile}"
                                      ToolTip="开（默认）：按行笔速度自动变粗细 —— 行笔快则细、收得住则粗，像真笔。
        关：笔宽恒定，与旧版完全一致（效果不满意时的一键回退）。" />

                            <TextBlock x:Name="CraftStrengthLabel" Text="力度"
                                       Style="{StaticResource Style.TextLabel}"
                                       VerticalAlignment="Center" Margin="{StaticResource Gap.Tile}" />

                            <Button x:Name="CraftButton0" Tag="0" Click="OnCraftStrengthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="CraftButton1" Tag="1" Click="OnCraftStrengthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="CraftButton2" Tag="2" Click="OnCraftStrengthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />

                            <!-- ==== 平滑（M18）：保点数指数平滑（只顺不细）==== -->
                            <CheckBox x:Name="SmoothCheckBox" Content="平滑"
                                      Click="OnSmoothClick"
                                      IsChecked="True"
                                      Style="{StaticResource Style.CheckBox}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource Gap.Tile}"
                                      ToolTip="开（默认）：笔迹更顺滑 —— 消除抖动毛刺与起笔小尾巴，字更干净。
        关：与旧版完全一致（觉得不跟手时的一键回退）。" />

                            <TextBlock x:Name="SmoothStrengthLabel" Text="顺滑"
                                       Style="{StaticResource Style.TextLabel}"
                                       VerticalAlignment="Center" Margin="{StaticResource Gap.Tile}" />

                            <Button x:Name="SmoothButton0" Tag="1" Click="OnSmoothStrengthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                            <Button x:Name="SmoothButton1" Tag="2" Click="OnSmoothStrengthClick"
                                    Style="{StaticResource Style.StepButton}" Margin="{StaticResource Gap.Tile}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Style.GroupDivider}" />

                        <!-- ================= 组 2 · 图形 =================
                             22 个学科工具（工具族已折叠，可见 16 颗）。
                             ★ 瓦片由 code-behind **直接挂在这个 WrapPanel 上**（不是嵌套容器）：
                               见上方关于"量宽度"的说明。 -->
                        <WrapPanel x:Name="ToolButtons">
                            <Border Style="{StaticResource Style.GroupHeaderChip}">
                                <TextBlock Style="{StaticResource Style.GroupHeaderLabel}" Text="图形" />
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource Style.GroupDivider}" />

                        <!-- ================= 组 3 · 文档 ================= -->
                        <WrapPanel x:Name="GroupPanelDoc">
                            <Border Style="{StaticResource Style.GroupHeaderChip}">
                                <TextBlock Style="{StaticResource Style.GroupHeaderLabel}" Text="文档" />
                            </Border>

                            <Button Command="{Binding OpenCommand}"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="打开试卷 PDF（快速模式：批注存在试卷旁边的 .tbink 文件里）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Folder}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="打开 PDF" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenProjectButton" Click="OnOpenProjectClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="打开 .twb 工程：试卷、批注、图形、视图位置一起恢复（Ctrl+Shift+O）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Folder}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="打开工程" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NewProjectButton" Click="OnNewProjectClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="新建空白工程：先随手写思路，回头再把试卷插进来（Ctrl+N）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.DocumentAdd}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="新建工程" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="CloseButton" Click="OnCloseClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="关闭当前工程；没打开工程时关闭试卷（Ctrl+W）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Dismiss}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="关闭" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <!-- 保存（M8：按模式分流）—— 一颗按钮管两件事，
                                 因为对老师来说"保存"永远是同一个动作。 -->
                            <Button x:Name="SaveButton" Click="OnSaveClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="有工程时保存整个工程（试卷 + 批注，Ctrl+S）；未建工程时只把批注存到试卷旁边的 .tbink 文件。">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Save}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="保存" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="SaveAsButton" Click="OnSaveProjectAsClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="把当前内容另存为一个新工程文件 .twb（Ctrl+Shift+S）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.SaveAs}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="另存为" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <!-- 导出（M20 S4 折叠）：两颗按钮并成一颗瓦片 + 二级菜单。
                                 导出是课前/课后的动作，课上几乎不点，占两格不值当。 -->
                            <Button x:Name="ExportButton" Click="OnExportButtonClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="导出当前试卷：整卷 PDF 或每页一张 PNG（含批注与图形）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Export}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="导出" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Style="{StaticResource Style.GroupDivider}" />

                        <!-- ================= 组 4 · 系统 ================= -->
                        <WrapPanel x:Name="GroupPanelSystem">
                            <Border Style="{StaticResource Style.GroupHeaderChip}">
                                <TextBlock Style="{StaticResource Style.GroupHeaderLabel}" Text="系统" />
                            </Border>

                            <!-- ==== 视口 ==== -->
                            <Button Click="OnFitWidthClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="按窗口宽度铺满整页（Ctrl+0）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.FitWidth}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="适应宽度" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button Content="100%" Click="OnActualSizeClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}" ToolTip="原始大小（Ctrl+1）" />

                            <Button Click="OnZoomOutClick" Style="{StaticResource Style.ToolbarIconButton}"
                                    Margin="{StaticResource Gap.Tile}" ToolTip="缩小（Ctrl+-）">
                                <Path Style="{StaticResource Style.IconPath}"
                                      Data="{StaticResource Icon.Subtract}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <Button Click="OnZoomInClick" Style="{StaticResource Style.ToolbarIconButton}"
                                    Margin="{StaticResource Gap.Tile}" ToolTip="放大（Ctrl+=）">
                                <Path Style="{StaticResource Style.IconPath}"
                                      Data="{StaticResource Icon.Add}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- ==== 撤销 / 重做（按钮可用态由 code-behind 跟随撤销栈刷新）==== -->
                            <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False"
                                    Style="{StaticResource Style.ToolbarIconButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="撤销上一步（Ctrl+Z）。一次落笔 / 一次擦除 / 一次清空 各算一步。">
                                <Path Style="{StaticResource Style.IconPath}"
                                      Data="{StaticResource Icon.Undo}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <Button x:Name="RedoButton" Click="OnRedoClick" IsEnabled="False"
                                    Style="{StaticResource Style.ToolbarIconButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="重做刚撤销的一步（Ctrl+Y）">
                                <Path Style="{StaticResource Style.IconPath}"
                                      Data="{StaticResource Icon.Redo}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <Button Click="OnClearInkClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="清空当前全部笔迹（按 Ctrl+Z 可以找回）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Trash}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="清除笔迹" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <!-- ==== M12：教学工作流 ==== -->
                            <Button x:Name="LayerPanelButton" Click="OnLayerPanelClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="图层：正式批注与随手草稿分开管，草稿可整体隐藏 / 一键清空">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Layers}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="图层" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuestionPrevButton" Click="OnQuestionPrevClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="跳到上一道标过号的题">
                                <TextBlock Text="上一题" Style="{StaticResource Style.TileText}" />
                            </Button>

                            <Button x:Name="QuestionNextButton" Click="OnQuestionNextClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="跳到下一道标过号的题（标记工具在「图形」组里，名字是「题号标记」）">
                                <TextBlock Text="下一题" Style="{StaticResource Style.TileText}" />
                            </Button>

                            <!-- 更多（M20 S4 折叠）：回放 / 计算器 / 纸张底色 / 工作台模式。
                                 都是"课前课后或偶尔用一次"的动作，折进来省三格。 -->
                            <Button x:Name="MoreButton" Click="OnMoreButtonClick"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="更多：书写回放、计算器、纸张底色、工作台模式">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.More}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock Text="更多" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <!-- 主题 / 窗口模式：全屏时没有标题栏、一体机上又没有键盘，
                                 它们是老师唯一的退路 —— 放在系统组的最后，但**永不折叠**。
                                 文字与图标由 code-behind 填（UpdateThemeButton / 窗口模式切换）。 -->
                            <Button x:Name="ThemeButton"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Click="OnToggleThemeClick"
                                    Margin="{StaticResource Gap.Tile}"
                                    ToolTip="切换界面主题。深色在投影与长时间使用下更护眼；浅色与试卷的白纸更连贯。（会记住你的选择）">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Theme}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock x:Name="ThemeButtonText" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="WindowModeButton"
                                    Style="{StaticResource Style.ToolbarTileButton}"
                                    Click="OnToggleWindowModeClick"
                                    Margin="{StaticResource Gap.Tile}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path x:Name="WindowModeIcon" Style="{StaticResource Style.ButtonIconPath}"
                                          Data="{StaticResource Icon.FullScreen}"
                                          HorizontalAlignment="Center" Margin="0" />
                                    <TextBlock x:Name="WindowModeText" Style="{StaticResource Style.TileText}" Margin="{StaticResource Tile.TextGap}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- ================= 兜底组 · 其他 =================
                             目录表里没登记的工具落到这里 —— 新插件带来的工具**看得见、点得着**，
                             而不是从工具栏上悄悄消失。空的时候整组（连同上面那条横线）一起收起。 -->
                        <StackPanel x:Name="GroupPanelOther" Visibility="Collapsed">
                            <Border Style="{StaticResource Style.GroupDivider}" />
                            <WrapPanel x:Name="OtherToolButtons">
                                <Border Style="{StaticResource Style.GroupHeaderChip}">
                                    <TextBlock Style="{StaticResource Style.GroupHeaderLabel}" Text="其他" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- ================ 二级菜单（Popup 不占流里的位置，放在最后）================ -->

                        <!-- 导出：PNG（每页一张）/ PDF（整卷多页） -->
                        <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource Style.PanelSurface}" Padding="{StaticResource Pad.Popup}">
                                <StackPanel>
                                    <Button x:Name="ExportPngButton" Click="OnExportPngClick" IsEnabled="False"
                                            Style="{StaticResource Style.ToolbarButton}"
                                            Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                            ToolTip="把当前试卷的每一页各导出一张 PNG 图片（200 dpi，含批注与图形，Ctrl+E）">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Image}" />
                                            <TextBlock Text="导出 PNG（每页一张）" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportPdfButton" Click="OnExportPdfClick" IsEnabled="False"
                                            Style="{StaticResource Style.ToolbarButton}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="把整卷导出成一份多页 PDF（200 dpi，含批注与图形，Ctrl+Shift+E）">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.DocumentPdf}" />
                                            <TextBlock Text="导出 PDF（整卷多页）" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 更多：回放 / 计算器 / 纸张底色 / 工作台模式
                             （M20 S4 把原来的纸张 Popup 与模式 Popup 合并到这里，
                               少两次"点开一个弹窗再点开另一个弹窗"。） -->
                        <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource Style.PanelSurface}" Padding="{StaticResource Pad.Popup}">
                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ReplayButton" Click="OnReplayClick"
                                                Style="{StaticResource Style.ToolbarButton}"
                                                MinWidth="118" Margin="0,0,6,0"
                                                ToolTip="回放本次会话的书写过程（逐步或自动播放；结束时原样恢复现场）">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.History}" />
                                                <TextBlock Text="回放" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CalculatorButton" Click="OnCalculatorClick"
                                                Style="{StaticResource Style.ToolbarButton}"
                                                MinWidth="118"
                                                ToolTip="简易计算器：乘除、开根号，手指直接按">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Style.ButtonIconPath}" Data="{StaticResource Icon.Calculator}" />
                                                <TextBlock Text="计算器" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="纸张底色（导出的文件也用这个底色）"
                                               Style="{StaticResource Style.TextLabel}" Margin="0,10,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Canvas.PageWhite}"
                                                BorderBrush="{StaticResource Ui.OverlayBorder}" BorderThickness="1"
                                                Tag="white" MouseLeftButtonUp="OnPaperColorPicked"
                                                Cursor="Hand" Margin="0,0,8,0" ToolTip="白" />
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Canvas.PageCream}"
                                                BorderBrush="{StaticResource Ui.OverlayBorder}" BorderThickness="1"
                                                Tag="cream" MouseLeftButtonUp="OnPaperColorPicked"
                                                Cursor="Hand" Margin="0,0,8,0" ToolTip="米黄" />
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Canvas.PageGreen}"
                                                BorderBrush="{StaticResource Ui.OverlayBorder}" BorderThickness="1"
                                                Tag="green" MouseLeftButtonUp="OnPaperColorPicked"
                                                Cursor="Hand" Margin="0,0,8,0" ToolTip="淡绿" />
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Canvas.PageBlue}"
                                                BorderBrush="{StaticResource Ui.OverlayBorder}" BorderThickness="1"
                                                Tag="blue" MouseLeftButtonUp="OnPaperColorPicked"
                                                Cursor="Hand" Margin="0,0,8,0" ToolTip="淡蓝" />
                                        <!-- 黑（深灰）：M21 起是出厂默认。描边沿用 Ui.OverlayBorder
                                             （深色主题是 37.5% 白、浅色主题是 25% 黑），
                                             两种主题下都能把这颗深色圆与原面板分开。 -->
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Canvas.PageBlack}"
                                                BorderBrush="{StaticResource Ui.OverlayBorder}" BorderThickness="1"
                                                Tag="black" MouseLeftButtonUp="OnPaperColorPicked"
                                                Cursor="Hand" ToolTip="深灰（默认）" />
                                    </StackPanel>

                                    <TextBlock Text="工作台模式（一串预设动作）"
                                               Style="{StaticResource Style.TextLabel}" Margin="0,10,0,6" />
                                    <StackPanel>
                                        <Button Content="批改（默认）" Click="OnModeGradingClick"
                                                Style="{StaticResource Style.ToolbarButton}" Margin="0,0,0,4"
                                                HorizontalAlignment="Stretch" />
                                        <Button Content="讲评" Click="OnModeReviewClick"
                                                Style="{StaticResource Style.ToolbarButton}" Margin="0,0,0,4"
                                                HorizontalAlignment="Stretch" />
                                        <Button Content="演示（藏工具栏）" Click="OnModePresentClick"
                                                Style="{StaticResource Style.ToolbarButton}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- M12 S2：悬浮球（工具栏收起形态；显示策略由 code-behind 按 auto/always/off 控制） -->
                <controls:FloatingBall x:Name="FloatingBallHost" Visibility="Collapsed" />
            </Grid>

            <!-- GeoGebra 停靠区（A1）。默认收起；形态切到停靠时由 code-behind 撑开。
                 顶栏（返回白板 / 切全屏）与网页区上下排布 —— 顶栏同样不能与 HWND 重叠。 -->
            <Border x:Name="GeoGebraDock" Grid.Column="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Style.ChromeBar}">
                        <DockPanel>
                            <Button x:Name="DockBackButton" DockPanel.Dock="Right"
                                    Content="返回白板（Esc）" Click="OnDockBackClick"
                                    Style="{StaticResource Style.DockButton}"
                                    ToolTip="退出演示面板，回到白板（按 Esc 也一样）" />
                            <Button x:Name="DockFullScreenButton" DockPanel.Dock="Right"
                                    Content="切全屏" Click="OnDockToggleFormClick"
                                    Style="{StaticResource Style.DockButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="改成全屏演示（快捷键 D）：满屏看清楚，讲台主用法" />

                            <TextBlock Text="GeoGebra（停靠）"
                                       Style="{StaticResource Style.TextStrong}" FontSize="{StaticResource Text.Label}"
                                       Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>

                    <!-- WebView2 的落位（停靠形态）。Background 给"纸白"：
                         页面未加载完时露出的底色必须与卷面同色，否则会看成"闪黑"。 -->
                    <Border x:Name="GeoGebraDockHost" Grid.Row="1"
                            Background="{StaticResource Canvas.PageWhite}" />
                </Grid>
            </Border>
        </Grid>

    </DockPanel>
</Window>
