<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ================================================================
         界面板 · 浅色（M10 S6 起可切换）

         ★ 与 Palette.Dark.xaml **键一一对应、值不同**（harness 有断言）。
           换肤只替换这一本，布局、结构、代码零改动 —— 这就是设计系统的意义。

         ★ 色温沿用现有深色家族的**暖灰**（R ≥ G ≥ B，不再往冷灰走）：
           ① 延续已经在用的护眼调子；
           ② 与白板的"纸"白共存时，暖白比冷白更不像"屏幕"；
           ③ 教室投影下暖白不刺眼。
           （偏色投影仪上会略显黄 —— 那时只换值、不动结构。）

         ★ 浅色下**文字与描边一律走深色系**：
           深色板的 #60FFFFFF 白描边画在浅底上等于没有，这里必须换成 #40000000。
         ================================================================ -->

    <!-- ================ 窗口与铬色 ================ -->
    <SolidColorBrush x:Key="Ui.WindowBackground" Color="#FFF2F1ED" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.ChromeBackground" Color="#FFE8E6E0" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.Divider" Color="#FFCCC9C0" po:Freeze="True" />

    <!-- ================ 文字三级 ================ -->
    <SolidColorBrush x:Key="Ui.TextPrimary" Color="#FF26251F" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.TextSecondary" Color="#FF55534B" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.TextMuted" Color="#FF7C7A72" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.TextDisabled" Color="#FFA8A69E" po:Freeze="True" />

    <!-- ================ 状态色（浅底上要压暗才够对比度）================ -->
    <SolidColorBrush x:Key="Ui.StatusDirty" Color="#FFB85A08" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.StatusWarning" Color="#FF8A6A00" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.StatusError" Color="#FFC41E1E" po:Freeze="True" />

    <!-- ================ 主色（与深色板同值：它是"笔的颜色"，不随主题变）================ -->
    <SolidColorBrush x:Key="Ui.Accent" Color="#FF0B5FD0" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.AccentSoft" Color="#1F0B5FD0" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.OnAccent" Color="#FFFFFFFF" po:Freeze="True" />

    <!-- ================ 浮层与控件底 ================
         浮层底仍是"铬色 + 高不透明度"：面板浮在**白纸**上，
         浅色界面里必须靠不透明度拉开与卷面的层次，否则面板像印在卷子上。 -->
    <SolidColorBrush x:Key="Ui.OverlayPanel" Color="#F2E8E6E0" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.OverlayBorder" Color="#40000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.FieldBackground" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.FieldBorder" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.ControlSurface" Color="#14000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.ControlHover" Color="#1F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.ControlPressed" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Ui.ControlDisabled" Color="#0F000000" po:Freeze="True" />

</ResourceDictionary>
