<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         面板 / 底板模板（M10 S4；M20 S2 补五态与过渡）

         「面板底板」是这个界面里反复出现、却一直没有名字的东西：
         工具栏、状态栏、停靠条、参数面板，本质都是「一块中性底 + 一条描边」。
         给它一个名字之后，改圆角 / 改描边只需要动这里。

         ★ M20 S2 起，面板内的按钮模板与 Buttons.xaml 用**同一套叠层做法**：
           常态底承载 DynamicResource，悬停/按下各是一层半透明 Border，
           状态切换只动画 Opacity。原理与硬规则见 Buttons.xaml 顶部那段长注释
           （为什么不能动画底色 / 为什么用 HoldEnd / 为什么触发器要带 IsEnabled）。
         ================================================================ -->

    <!-- 铬条：工具栏 / 状态栏 / 停靠条顶栏 -->
    <Style x:Key="Style.ChromeBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.ChromeBackground}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Toolbar}" />
    </Style>

    <Style x:Key="Style.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.ChromeBackground}" />
        <Setter Property="Padding" Value="{StaticResource Pad.StatusBar}" />
    </Style>

    <!-- 浮层底板：参数面板、弹窗正文这类「浮在卷面上」的东西。
         半透明是刻意的 —— 老师要能一边看图形一边调参数。 -->
    <Style x:Key="Style.PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.OverlayPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner.M}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Toolbar}" />
    </Style>

    <!-- 文本输入框（参数面板的数值框） -->
    <Style x:Key="Style.FieldBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Ui.FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.BodyStrong}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="MinHeight" Value="{StaticResource Touch.Compact}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 面板里的小按钮（收起面板的 ✕）——
         比工具栏按钮小一档，但仍然 ≥ 36：手指点得中。

         ★ M20 S2 补上模板：这个样式原先**没有 Template**，走的是 WPF 默认按钮模板 ——
           而默认模板的 IsMouseOver 触发器会把 Background 换成系统浅蓝
           （Aero2 的 ButtonMouseOverBackground），完全无视我们的深色主题。
           平时看不出来（底色是 Transparent，静止态正常），一悬停就闪一块浅蓝。
           现在给它自己的叠层模板：常态透明，悬停淡入 Ui.ControlHover。 -->
    <Style x:Key="Style.PanelCloseButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Touch.Compact}" />
        <Setter Property="Height" Value="{StaticResource Touch.Compact}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <Border x:Name="HoverFx" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource Ui.ControlHover}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <Border x:Name="PressFx" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource Ui.ControlPressed}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ui.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 面板里的加减按钮 -->
    <Style x:Key="Style.PanelStepButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Touch.Min}" />
        <Setter Property="Height" Value="{StaticResource Touch.Min}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource Text.Title}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Ui.ControlSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <Border x:Name="HoverFx" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource Ui.ControlHover}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <Border x:Name="PressFx" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource Ui.ControlPressed}"
                                CornerRadius="{StaticResource Corner.S}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- 禁用：直接改 Bd 与前景色（这两个属性没有被任何动画占据） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.ControlDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ui.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================ 文字层级（XAML 里直接套，省掉到处写 FontSize/Foreground）================ -->
    <Style x:Key="Style.TextTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Title}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Style.TextStrong" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.BodyStrong}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Style.TextBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Style.TextLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Style.TextCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
