<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         输入类控件模板（M10 S3；M20 S2 补五态与过渡）

         只有两个真需求：勾选框（压感 / 笔锋 / 平滑）与提示气泡（全界面）。
         ★ 提示气泡用**隐式样式**（没有 x:Key）：ToolTip 是弹层，
           没法逐个引用样式，只能全局给一份。
           这是本项目里唯一一处有意的「全局覆盖」，范围仅限 ToolTip ——
           Button 之类的隐式样式一律不写（那会连插件界面一起改掉）。

         ★ M20 S2：勾选框改用与按钮同一套叠层做法（常态底承载 DynamicResource，
           悬停 / 选中 / 按下各一层半透明 Border，只动画 Opacity）。
           原理与硬规则见 Buttons.xaml 顶部那段长注释。
         ================================================================ -->

    <!-- ================ 勾选框 ================
         自绘：默认 WPF 勾选框在一体机上只有 13×13，手指点不中，
         而「压感开关」是老师开课前会去点的一个。

         ★ M20 S2 改动的三件事：
           ① 选中不再靠「整块底色瞬时替换」，而是让 CheckFx 层淡入 ——
              CheckFx 与 Bd 的 BorderThickness / CornerRadius 完全一致，
              所以淡入之后看过去仍然是一个整块主色方框（与 M10 的观感一致），
              但中间多了 150ms 的过渡。
           ② 勾（Tick）用 Opacity 过渡而不是 Visibility 瞬切：
              Visibility 是离散量、动画不了，硬做只能「啪」地跳出来。
           ③ 勾的颜色从 Ui.WindowBackground 换成 Ui.OnAccent ——
              WindowBackground 在浅色主题下是**浅色**，画在蓝底上几乎看不见
              （这是 M10 留下的隐患，浅色主题下一眼就能看出来）。
              Ui.OnAccent 的语义就是「画在主色上的内容」，两个主题下都成立。 -->
    <Style x:Key="Style.CheckBox" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource Touch.Min}" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- 四个层**完全重叠**在同一个 22×22 方格里（用 Grid 而不是
                             把层塞进 Border 内部）：塞进去的话每层会被描边挤小 1.5px，
                             淡入时方框里会出现一圈底色缝。 -->
                        <Grid Width="{StaticResource Ind.CheckSize}"
                              Height="{StaticResource Ind.CheckSize}"
                              VerticalAlignment="Center">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource Ui.FieldBackground}"
                                    BorderBrush="{DynamicResource Ui.OverlayBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="{StaticResource Corner.S}" />
                            <Border x:Name="BoxHover" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource Ui.ControlHover}"
                                    CornerRadius="{StaticResource Corner.S}" />
                            <Border x:Name="CheckFx" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource Ui.Accent}"
                                    BorderBrush="{DynamicResource Ui.Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="{StaticResource Corner.S}" />
                            <Border x:Name="PressFx" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource Ui.ControlPressed}"
                                    CornerRadius="{StaticResource Corner.S}" />
                            <Path x:Name="Tick"
                                  Data="M 2,6 L 5.5,9.5 L 12,2.5"
                                  Stroke="{DynamicResource Ui.OnAccent}"
                                  StrokeThickness="2.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="None"
                                  Opacity="0"
                                  IsHitTestVisible="False"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- 选中：底色与勾一起淡入。这是「状态」，正是主色该出现的地方。 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressFx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Standard}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ui.TextDisabled}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.ControlDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.ControlDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================ 提示气泡（隐式，全界面生效）================
         ★ 一体机上提示要**更大**：默认 12 号在 3 米外是一片糊。
         ★ 一体机上提示要**更快出来**：老师在按钮上悬停/长按的耐心比鼠标用户短得多。
           （显示时长 ToolTipService.ShowDuration 是附加在「拥有者」上的属性，
             样式里设不了，需要单独控制的按钮自己设一个。） -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Ui.OverlayPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.Toolbar}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Body}" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        <!-- ★ 刻意不留内建投影开关（M20 S0）：HasDropShadow 是 WPF 里**唯一**
             名字里没有 Effect、却会真的往视觉树里塞 DropShadowEffect 的内建属性
             （ToolTip 的默认模板吃它）。我们给了自己的模板，一旦有人把模板退回
             默认，它就会静默长出一圈阴影（一体机是集显，阴影走软件合成）。
             ⇒ 连 Setter 都不留（默认即 False），护栏正则也盯着这个属性名。 -->
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Corner.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
