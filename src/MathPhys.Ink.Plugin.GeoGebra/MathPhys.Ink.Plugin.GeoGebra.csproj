<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与宿主同一目标框架：契约类型要在同一运行时里共享 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MathPhys.Ink.Plugin.GeoGebra</AssemblyName>
    <RootNamespace>MathPhys.Ink.Plugin.GeoGebra</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件只引用契约，不引用宿主 —— 这是插件形态的定义本身。
         ★ 特别地，本插件**不引用 WebView2**：面板由宿主创建与管理，
           插件只通过 IToolContext.GeoGebra 这个受控通道说话。
           哪天宿主换掉 WebView2（哪怕换成别的），这个插件一行都不用改。 -->
    <ProjectReference Include="..\MathPhys.Ink.Plugin.Abstractions\MathPhys.Ink.Plugin.Abstractions.csproj" />
  </ItemGroup>

</Project>
