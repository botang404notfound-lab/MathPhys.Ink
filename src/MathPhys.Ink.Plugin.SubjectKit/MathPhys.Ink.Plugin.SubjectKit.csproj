<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MathPhys.Ink.Plugin.SubjectKit</RootNamespace>
    <!-- dll 名与目录名一致：加载器的约定是 plugins\subjectkit\subjectkit.dll -->
    <AssemblyName>subjectkit</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与其它学科工具同款：只引用契约；本插件不落图形对象渲染器（图片走宿主 AddImage 通道） -->
    <ProjectReference Include="..\MathPhys.Ink.Plugin.Abstractions\MathPhys.Ink.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 电场线等学科图片：嵌进 dll（EmbeddedResource），随插件分发、不依赖包内路径。
         用嵌入资源而不是 Content：插件按目录加载，Content 的相对路径在 ALC 里是坑。 -->
    <EmbeddedResource Include="Assets\**\*.png" />
  </ItemGroup>

</Project>
