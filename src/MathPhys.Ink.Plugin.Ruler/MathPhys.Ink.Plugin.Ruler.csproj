<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与宿主同一目标框架：契约类型要在同一运行时里共享 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MathPhys.Ink.Plugin.Ruler</AssemblyName>
    <RootNamespace>MathPhys.Ink.Plugin.Ruler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件只引用契约，不引用宿主 —— 这是插件形态的定义本身：
         宿主换实现（换 PDF 引擎、换采集路线）不该让插件重新编译。 -->
    <ProjectReference Include="..\MathPhys.Ink.Plugin.Abstractions\MathPhys.Ink.Plugin.Abstractions.csproj" />
  </ItemGroup>

</Project>
