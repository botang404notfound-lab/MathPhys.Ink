<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架必须与主程序一致：插件要在同一运行时里与宿主共享这些类型 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>MathPhys.Ink.Plugins</RootNamespace>
    <AssemblyName>MathPhys.Ink.Plugin.Abstractions</AssemblyName>
    <!-- 契约里会出现 Cursor / Stroke / Point 等 WPF 类型，Nullable 严格一些能让插件作者尽早发现问题 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>

    <!-- 契约版本。★ 改契约时的规则：
         ① 破坏性改动（改名、改语义、给 ITool 加成员）→ 主版本 +1，老插件会被明确拒绝；
         ② 只加新接口 / 给"仅由宿主实现"的接口加成员 → 次版本 +1，老插件照常加载。
         加载器靠"插件对契约 dll 的引用版本"判断兼容性（见 PluginContract）：
         主版本必须相等，且次版本不得高于宿主。 -->
    <!-- 1.2.0（M7.4 Step 1）：加 IBoardQuery（新接口）+ IToolContext.Query（加成员，
         但 IToolContext 只由宿主实现，插件只消费 ⇒ 对插件不是破坏性改动）。 -->
    <!-- 1.3.0（M7.5 S0）：加 IGeoGebraBridge / GeoGebraMessage / GeoGebraProtocol /
         ITransientTool（全是新接口与新类型）+ IToolContext.GeoGebra（加成员，同上）。
         本次改动对已分发的旧插件 dll 是纯增量的：旧 dll 引用的类型与成员一个没变。 -->
    <!-- 1.4.0（M19）：加 ICancellableTool（纯新增可选接口）⇒ 按规则②只升次版本，
         老插件引用 1.3.0 照常加载，新圆规插件引用 1.4.0 与宿主相等。 -->
    <!-- 1.5.0（M22）：加 IWebPanelBridge / WebPanelMessage / WebPanelProtocol / WebPanelIds
         （全是新接口与新类型）+ IToolContext.WebSim（加成员；IToolContext 只由宿主实现、
         插件只消费 ⇒ 对插件不是破坏性改动）。仍按规则②只升次版本：
         ★ ITool 一个成员都没动，老插件 dll 引用的类型与成员一个没变，照常加载。 -->
    <!-- 1.6.0（M22 S3）：加 IGfxObjectHost.AddImage（加成员，但 IGfxObjectHost
         只由宿主实现、插件只消费 ⇒ 对插件不是破坏性改动）+ WebSimPages（新类型）。
         仍按规则②只升次版本：★ ITool 一个成员都没动，老插件 dll 照常加载。 -->
    <!-- 1.7.0（M26）：加 MathKeyboard（数学键盘可复用组件：表达式/LaTeX 两套布局 + 共享插入逻辑，纯新增类型）。
         注：M25 的 GfxTextField / IGfxTextParameterSink 同为纯新增但当时未补版本号，此处一并追认。
         按规则②只升次版本：★ ITool 一个成员都没动，旧插件 dll 引用的类型与成员一个没变，照常加载。 -->
    <!-- 2.0.0（改名 M27）：项目改名 唐波的白板 → 数理墨（MathPhys Ink），契约程序集简单名
         由 TangBo.WhiteBoard.Plugin.Abstractions 变为 MathPhys.Ink.Plugin.Abstractions。
         ★ 契约 dll 无强名称，.NET 按简单名绑定 ⇒ 旧插件 dll 引用的程序集名与本宿主不同，
           属「改名」类破坏性改动，按规则①主版本 +1。所有插件 dll 必须随宿主一起重建。 -->
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>
